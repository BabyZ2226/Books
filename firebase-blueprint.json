{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "A book added by the user to their library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "summary": { "type": "string" },
        "coverUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["Leyendo", "Terminado", "Por leer", "Abandonado"] },
        "startDate": { "type": "number" },
        "endDate": { "type": "number" },
        "addedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "author", "status", "addedAt"]
    },
    "Note": {
      "title": "Note",
      "description": "A note taken on a book",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bookId": { "type": "string" },
        "content": { "type": "string" },
        "reference": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "relatedNoteIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "audioData": { "type": "string" },
        "audioStartTime": { "type": "number" },
        "audioEndTime": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "bookId", "content", "createdAt", "updatedAt"]
    },
    "GlossaryTerm": {
      "title": "GlossaryTerm",
      "description": "A glossary term associated with a book",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bookId": { "type": "string" },
        "word": { "type": "string" },
        "definition": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "bookId", "word", "definition", "createdAt"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "A study flashcard for a book",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bookId": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "bookId", "question", "answer", "createdAt"]
    },
    "Insight": {
      "title": "Insight",
      "description": "AI-generated insight for a book",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bookId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["connection", "epiphany", "application"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "bookId", "title", "description", "type", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message in a chat with the AI tutor for a specific book",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bookId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "bookId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "User's book library"
    },
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Notes for all books"
    },
    "/terms/{termId}": {
      "schema": { "$ref": "#/entities/GlossaryTerm" },
      "description": "Glossary terms for all books"
    },
    "/flashcards/{cardId}": {
      "schema": { "$ref": "#/entities/Flashcard" },
      "description": "Flashcards for all books"
    },
    "/insights/{insightId}": {
      "schema": { "$ref": "#/entities/Insight" },
      "description": "Insights for all books"
    },
    "/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Chat history for books"
    }
  }
}
