rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isVerified() {
      return true;
    }

    // Validators
    function isValidBook(data) {
      return data.id is string
        && data.userId == request.auth.uid
        && data.title is string
        && data.author is string;
    }

    function isValidNote(data) {
      return data.id is string
        && data.userId == request.auth.uid
        && data.bookId is string;
    }

    function isValidTerm(data) {
      return data.id is string
        && data.userId == request.auth.uid
        && data.bookId is string;
    }

    // Books Collection
    match /books/{bookId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn()
        && isValidId(bookId)
        && isValidBook(incoming())
        && incoming().id == bookId;

      allow update: if isSignedIn()
        && isValidId(bookId)
        && existing().userId == request.auth.uid
        && isValidBook(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;
        
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Notes Collection
    match /notes/{noteId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn()
        && isValidId(noteId)
        && isValidNote(incoming())
        && incoming().id == noteId;

      allow update: if isSignedIn()
        && isValidId(noteId)
        && existing().userId == request.auth.uid
        && isValidNote(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().bookId == existing().bookId;
        
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Terms Collection
    match /terms/{termId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn()
        && isValidId(termId)
        && isValidTerm(incoming())
        && incoming().id == termId;

      allow update: if isSignedIn()
        && isValidId(termId)
        && existing().userId == request.auth.uid
        && isValidTerm(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().bookId == existing().bookId;
        
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
